{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build --workspace=@sih/shared && cd client && npx vite build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://sih26-wfjr.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
