# ==============================================================================
# Environment Configuration — Legal Metrology Verification System (Backend)
# ==============================================================================

# Server Runtime
PORT=5001
NODE_ENV=development
LOG_LEVEL=info

# Database Connection (PostgreSQL)
# For local development or managed cloud PostgreSQL (Supabase, Neon, Render)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/legal_metrology?schema=public

# Authentication Secrets (Generate in production: openssl rand -hex 32)
JWT_ACCESS_SECRET=e7b4a206cfd15024479cf8d154df6568c07f4339e8dc9f6655c65f97305d2be1
JWT_REFRESH_SECRET=2b69424759fa2077e68bc6cb61d76ea24fbbf0d8c067e7279fcfd064cfbcf76a
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage — Cloudinary (Photos, Verification Documents, Certificate PDFs)
CLOUDINARY_CLOUD_NAME=demo-cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz12

# Asymmetric PKI Certificate Signing (ECDSA P-256 / SHA-256)
# If left blank, server auto-generates a keypair on first run and persists to DB
PKI_ACTIVE_KEY_VERSION=v1-2026
PKI_KEY_ENCRYPTION_SECRET=8f46d3e86c04f9810f63b216ab7140e1b6c07a97495b281f9a037841cbb14792

# Client & Public Verification URLs
CLIENT_URL=http://localhost:5173
PUBLIC_VERIFICATION_URL=http://localhost:5173/verify
MOBILE_APP_SCHEME=legalmetrology://
